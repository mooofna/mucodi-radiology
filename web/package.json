{
  "name": "mucodi-radiology-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "In-browser CPU demo of the MuCoDi chest CT students",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "prepare-runtime": "node scripts/copy-runtime.mjs",
    "dev": "npm run prepare-runtime && vite dev",
    "build": "npm run prepare-runtime && vite build",
    "preview": "vite preview --port 4173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@niivue/dcm2niix": "1.3.20260724",
    "@niivue/niivue": "0.69.0",
    "@observablehq/plot": "^0.6.17",
    "coi-serviceworker": "0.1.7",
    "nifti-reader-js": "^0.8.0",
    "onnxruntime-web": "1.30.0"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  }
}
